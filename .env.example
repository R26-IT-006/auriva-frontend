# Copy this file to .env and update the values

# Backend API base URL
# Android Emulator: http://10.0.2.2:3000/api
# iOS Simulator: http://localhost:3000/api
# Physical device: http://<your-local-ip>:3000/api
API_BASE_URL=http://10.0.2.2:3000/api

# ── Demonstration only ───────────────────────────────────────────────────
# Opens Uppercase and Words before a child has earned them, clearly marked
# in the UI as a "Preview". Leave this OUT of any build a child will use.
#
# Absent (the default), empty or anything other than the exact word `true`
# is treated as false — the app then gates progression normally.
#
#   EXPO_PUBLIC_DEMO_PREVIEW_UNLOCK=true
#
# Metro inlines EXPO_PUBLIC_* at bundle time, so restart the dev server
# (npx expo start -c) after changing it.
