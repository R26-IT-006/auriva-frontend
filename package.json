{
  "name": "auriva-frontend",
  "version": "1.0.0",
  "main": "index.js",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "postinstall": "node scripts/patch-freeport-async.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "start": "node scripts/start-expo.js --go --lan --port 8081",
    "start:tunnel": "expo start --go --tunnel --port 8081",
    "start:local": "expo start --go --localhost --port 8081",
    "start:lan": "node scripts/start-expo.js --go --lan --port 8081",
    "start:clear": "node scripts/start-expo.js --go --lan --port 8081 --clear",
    "start:dev-client": "node scripts/start-expo.js --dev-client --lan --port 8081",
    "start:dev-client:clear": "node scripts/start-expo.js --dev-client --lan --port 8081 --clear",
    "android": "node scripts/run-android.js",
    "android:go": "node scripts/start-expo.js --go --lan --port 8081 --android",
    "ios": "expo run:ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.15.7",
    "@react-navigation/native": "^7.2.0",
    "@react-navigation/native-stack": "^7.14.7",
    "axios": "^1.19.0",
    "expo": "~54.0.37",
    "expo-asset": "~12.0.13",
    "expo-av": "~16.0.8",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-modules-core": "~3.0.30",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/react-native": "^14.0.1",
    "babel-preset-expo": "~54.0.10",
    "jest-expo": "~54.0.18",
    "react-test-renderer": "^19.1.0"
  },
  "private": true
}
